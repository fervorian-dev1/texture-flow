<Window x:Class="TextureFlow.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TextureFlow" AllowDrop="True" PreviewDragOver="IncomingDrag" PreviewDragEnter="IncomingDrag" PreviewDragLeave="LeavingDrag" PreviewDrop="IncomingDrop" Icon="Assets/AppIcon.ico" Title="Texture Flow - Avatar effects made simple" Width="1380" Height="940" MinWidth="1080" MinHeight="760" Background="#151923" Foreground="#E8EDF7">
 <Window.Resources><local:ProjectNameConverter x:Key="ProjectName"/>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#182030"/><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="10,7"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Margin" Value="4"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="#182030"/><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="5"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#182030"/><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="5"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E8EDF7"/><Setter Property="Margin" Value="5"/></Style>
  <Style TargetType="Expander"><Setter Property="Margin" Value="3,8"/><Setter Property="Foreground" Value="#C4D2E8"/></Style>
 </Window.Resources>
 <DockPanel Margin="18">
  <StackPanel DockPanel.Dock="Top">
   <DockPanel><WrapPanel DockPanel.Dock="Right"><Button Content="Try the demo" Click="Demo"/><Button Content="Save work" Click="SaveSession"/><Button Content="Open saved work" Click="LoadSession"/></WrapPanel><StackPanel><TextBlock Text="TEXTURE FLOW" FontSize="26" FontWeight="Bold"/><TextBlock Text="Choose your texture. Select a stripe. Make it move." Foreground="#9CAFCB"/></StackPanel></DockPanel>
   <Border x:Name="DropBanner" BorderBrush="#52647F" BorderThickness="1" CornerRadius="6" Padding="6" Margin="3,6"><DockPanel><Border x:Name="FlowDrop" DockPanel.Dock="Right" Background="#34465F" CornerRadius="4" Padding="10,4"><TextBlock Text="Drop moving texture here"/></Border><TextBlock Text="Drop an image or project folder here. Hold Shift to load the moving texture." VerticalAlignment="Center"/></DockPanel></Border>
  </StackPanel>
  <Border DockPanel.Dock="Bottom" Background="#243248" CornerRadius="5" Padding="8" Margin="3,8,3,0"><TextBlock x:Name="Status" Text="Start with step 1, or click Try the demo."/></Border>
  <TabControl x:Name="Steps" DockPanel.Dock="Left" Width="365" Background="#151923" BorderBrush="#52647F" Padding="4"><TabItem Header="1 Textures" Foreground="#182030"><ScrollViewer VerticalScrollBarVisibility="Auto" Foreground="#E8EDF7" Padding="5"><StackPanel>   <TextBlock Text="1  CHOOSE YOUR TEXTURES" FontWeight="Bold" FontSize="16"/>
   <TextBlock Text="Your Unity project"/><ComboBox x:Name="Projects" SelectionChanged="ProjectChanged"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource ProjectName}}" ToolTip="{Binding}" TextWrapping="NoWrap"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><WrapPanel><Button Content="Choose project folder" Click="BrowseProject"/><Button Content="Browse its textures" Click="BrowseTextures"/></WrapPanel>
   <Button Content="Open original avatar texture" Click="OpenBase"/><TextBlock x:Name="BaseLabel" Text="No original texture loaded" Foreground="#9CAFCB"/>
   <Button Content="Open moving texture for selected area" Click="OpenFlow"/><TextBlock x:Name="FlowLabel" Text="Choose the pattern that will move inside your selection" Foreground="#9CAFCB"/>
<WrapPanel Margin="0,12,0,0"><Button Content="Next: select and animate" Tag="1" Click="ChangeStep"/></WrapPanel></StackPanel></ScrollViewer></TabItem><TabItem Header="2 Effect" Foreground="#182030"><ScrollViewer VerticalScrollBarVisibility="Auto" Foreground="#E8EDF7" Padding="5"><StackPanel>   <StackPanel x:Name="EffectsPanel"><TextBlock Text="INDEPENDENT AREAS" FontSize="16" FontWeight="Bold"/>
<ListBox x:Name="Effects" Height="100" Background="#202838" Foreground="#E8EDF7" SelectionChanged="EffectSelected"><ListBox.ItemTemplate><DataTemplate><DockPanel><CheckBox IsChecked="{Binding Enabled,Mode=TwoWay}" ToolTip="Include this area in preview and export"/><StackPanel><TextBlock Text="{Binding Name}" FontWeight="Bold"/><TextBlock Text="{Binding FlowName}" FontSize="11" Foreground="#9CAFCB"/></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
<TextBox Text="{Binding SelectedItem.Name,ElementName=Effects,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" ToolTip="Name this area, for example Red stripe or Sole"/>
<WrapPanel><Button Content="Add next area" Click="AddArea"/><Button Content="Duplicate" Click="DuplicateArea"/><Button Content="Remove" Click="RemoveArea"/></WrapPanel>
<Button Content="Choose moving image for THIS area..." Click="OpenFlow"/>
<Expander Header="More area actions"><StackPanel><Button Content="Add moving image as NEW area..." Click="AddMovingArea"/><Button Content="Browse project textures..." Click="BrowseTextures"/><WrapPanel><Button Content="Move earlier" Tag="-1" Click="ReorderArea"/><Button Content="Move later" Tag="1" Click="ReorderArea"/></WrapPanel><Button Content="Restore removed area" Click="RestoreRemovedArea"/><TextBlock Text="Later areas cover earlier areas where their masks overlap."/></StackPanel></Expander>
<TextBlock x:Name="AreaHint" Foreground="#9CAFCB"/>
<TextBlock Text="Each of up to 8 areas has its own image and motion." Foreground="#9CAFCB"/>
<TextBlock Text="2  SELECT AND ANIMATE" FontWeight="Bold" FontSize="16" Margin="4,16,4,4"/>
   <TextBlock Text="Fill the color, then refine it with Paint add or Paint erase. Switching tools keeps the selection."/>
<WrapPanel><Button x:Name="QuickFill" Content="Fill color" Tag="0" Click="QuickSelectionTool"/><Button x:Name="QuickAdd" Content="Paint add" Tag="3" Click="QuickSelectionTool"/><Button x:Name="QuickErase" Content="Paint erase" Tag="4" Click="QuickSelectionTool"/></WrapPanel>
<ComboBox x:Name="SelectionMode" SelectedIndex="1"><ComboBoxItem Content="Replace this area's selection"/><ComboBoxItem Content="Add to this area's selection"/><ComboBoxItem Content="Remove from this area's selection"/></ComboBox>
   <ComboBox x:Name="Tool" SelectedIndex="0" SelectionChanged="ToolChanged"><ComboBoxItem Content="Select connected color (magic wand)"/><ComboBoxItem Content="Select this color everywhere"/><ComboBoxItem Content="Select similar hues everywhere"/><ComboBoxItem Content="Brush: add area"/><ComboBoxItem Content="Brush: remove area"/><ComboBoxItem Content="Draw around an area (lasso)"/><ComboBoxItem Content="Click around an area (polygon)"/></ComboBox>
   <TextBlock Text="Include similar shades"/><Slider x:Name="Tolerance" Minimum="0" Maximum="255" Value="32" ToolTip="Higher values include more colors"/><WrapPanel><Button Content="Undo selection" Click="Undo"/><Button Content="Redo" Click="RedoSelection"/><Button Content="Clear selection" Click="Clear"/></WrapPanel>
   <TextBlock Text="Brush size"/><Slider x:Name="BrushSize" Minimum="1" Maximum="512" Value="40"/><TextBlock Text="Movement direction (this area)"/><WrapPanel><Button Content="Left" Tag="180" Click="DirectionPreset"/><Button Content="Up" Tag="90" Click="DirectionPreset"/><Button Content="Down" Tag="270" Click="DirectionPreset"/><Button Content="Right" Tag="0" Click="DirectionPreset"/></WrapPanel>
   <TextBlock Text="Movement speed"/><WrapPanel><Button Content="Slow" Tag="0.05" Click="SpeedPreset"/><Button Content="Medium" Tag="0.25" Click="SpeedPreset"/><Button Content="Fast" Tag="1" Click="SpeedPreset"/></WrapPanel><TextBox x:Name="Speed" Text="0.1" ToolTip="Speed from 0.01 to 100"/>
   <TextBlock Text="Glow strength"/><TextBox x:Name="Emission" Text="2" ToolTip="0 to 100"/>
   <Expander Header="Advanced selection and edge cleanup"><StackPanel>
    <TextBlock Text="Hue / saturation / brightness tolerance"/><WrapPanel><TextBox x:Name="Hue" Text="20" Width="80"/><TextBox x:Name="Sat" Text="0.25" Width="80"/><TextBox x:Name="Val" Text="0.25" Width="80"/></WrapPanel>
    <TextBlock Text="Brush softness"/><Slider x:Name="Softness" Minimum="0" Maximum="1" Value="0.3"/>
    <TextBlock Text="Cleanup amount (pixels)"/><TextBox x:Name="Radius" Text="2"/><WrapPanel><Button Content="Grow" Click="Grow"/><Button Content="Shrink" Click="Shrink"/><Button Content="Soften edges" Click="Feather"/><Button Content="Smooth" Click="Smooth"/><Button Content="Fill gaps" Click="FillHoles"/></WrapPanel>
   </StackPanel></Expander>
   <Expander Header="Advanced motion, color and shader"><StackPanel>
    <TextBlock Text="Custom direction (degrees)"/><Slider x:Name="Angle" Minimum="0" Maximum="360" Value="90"/>
    <TextBlock Text="Repeat X / Y / rotation (degrees)"/><WrapPanel><TextBox x:Name="TileX" Text="1" Width="80"/><TextBox x:Name="TileY" Text="1" Width="80"/><TextBox x:Name="Rotation" Text="0" Width="80"/></WrapPanel>
    <TextBlock Text="Pattern tint (#RRGGBB; white keeps image colors)"/><TextBox x:Name="Tint" Text="#FFFFFF"/><TextBlock Text="Extra HDR brightness"/><TextBox x:Name="Hdr" Text="0"/>
    <TextBlock Text="Shader for exported materials"/><ComboBox x:Name="Shader" SelectedIndex="0"><ComboBoxItem Content="TextureFlow fallback"/><ComboBoxItem Content="Poiyomi"/><ComboBoxItem Content="lilToon"/></ComboBox><TextBlock Text="All enabled areas are combined in one Texture Flow material. Native shader export supports single-area effects only." Foreground="#9CAFCB"/>
    <TextBlock x:Name="Editors" TextWrapping="Wrap"/>
   </StackPanel></Expander>
</StackPanel><WrapPanel Margin="0,12,0,0"><Button Content="Back to textures" Tag="0" Click="ChangeStep"/><Button Content="Next: apply" Tag="2" Click="ChangeStep"/></WrapPanel></StackPanel></ScrollViewer></TabItem><TabItem Header="3 Apply" Foreground="#182030"><ScrollViewer VerticalScrollBarVisibility="Auto" Foreground="#E8EDF7" Padding="5"><StackPanel>   <TextBlock Text="3  APPLY TO YOUR AVATAR" FontWeight="Bold" FontSize="16" Margin="4,16,4,4"/>
   <TextBlock Text="Keep this project open in Unity, with your avatar in its scene."/>
   <Button Content="Connect to Unity / refresh avatar parts" Click="ConnectUnity"/><TextBlock x:Name="ConnectionLabel" Text="The included connector sets itself up automatically." Foreground="#9CAFCB"/>
   <TextBlock Text="Avatar part to change"/><ComboBox x:Name="Targets" DisplayMemberPath="label" ToolTip="Choose one renderer material slot. Other slots stay unchanged."/>
   <Button x:Name="ApplyButton" Content="Create &amp; Apply" Click="CreateAndApply" Background="#63D9CA" FontSize="16" FontWeight="Bold" Padding="12"/>
   <Button x:Name="RestoreButton" Content="Restore previous material" Click="RestoreMaterial" IsEnabled="False"/>
   <TextBlock Text="Applies to the chosen part in your open scene. Save the scene in Unity to keep it. The chosen slot uses a new material; its old shader appearance may change. This does not upload to VRChat." Foreground="#9CAFCB"/>
   <Expander Header="Save files without applying"><StackPanel><Button Content="Create Unity material only" Click="Export"/><TextBlock Text="Creates textures and a material in your project. Does not change your avatar." Foreground="#9CAFCB"/></StackPanel></Expander>
<WrapPanel Margin="0,12,0,0"><Button Content="Back to effect" Tag="1" Click="ChangeStep"/></WrapPanel></StackPanel></ScrollViewer></TabItem></TabControl>
  <DockPanel Margin="12,4,0,0">
   <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6"><CheckBox x:Name="Playing" Content="Play animation" IsChecked="True"/><CheckBox x:Name="Before" Content="Show original"/><CheckBox x:Name="ShowMask" Content="Highlight selected area" IsChecked="False"/><TextBlock Text="Wheel: zoom | Middle drag: pan" Foreground="#9CAFCB"/></WrapPanel>
   <Expander DockPanel.Dock="Bottom" Header="Preview layers"><WrapPanel><CheckBox x:Name="ShowBase" Content="Original texture" IsChecked="True"/><CheckBox x:Name="ShowFlow" Content="Moving texture" IsChecked="True"/><CheckBox x:Name="ShowGlow" Content="Glow" IsChecked="True"/></WrapPanel></Expander>
   <Border Background="#202838" ClipToBounds="True" CornerRadius="6"><ScrollViewer x:Name="Viewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Grid x:Name="CanvasHost" Width="760" Height="760" Background="#303849"><Image x:Name="Preview" Focusable="True" Stretch="Fill" MouseDown="PointerDown" MouseMove="PointerMove" MouseUp="PointerUp" MouseWheel="Zoom"/><Polyline x:Name="Outline" Stroke="#FFCC55" StrokeThickness="2" IsHitTestVisible="False"/></Grid></ScrollViewer></Border>
  </DockPanel>
 </DockPanel>
</Window>
