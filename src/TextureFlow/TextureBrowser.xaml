<Window x:Class="TextureFlow.TextureBrowser" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Project Texture Browser • Texture Flow" Width="920" Height="750" MinWidth="650" MinHeight="450" Background="#151923" Foreground="#E8EDF7" Icon="Assets/AppIcon.ico" WindowStartupLocation="CenterOwner">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="4"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="4"/></Style>
 </Window.Resources>
 <DockPanel Margin="16">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="PROJECT TEXTURES" FontSize="23" FontWeight="Bold" Margin="4"/>
   <TextBlock x:Name="ProjectLabel" TextWrapping="Wrap" Foreground="#9CAFCB" Margin="4"/>
   <DockPanel><Button Content="Refresh" Click="Refresh" DockPanel.Dock="Right"/><TextBox x:Name="Search" TextChanged="SearchChanged" ToolTip="Search texture names, extensions or folders"/></DockPanel>
   <CheckBox x:Name="Packages" Content="Include installed package textures" Foreground="#E8EDF7" IsChecked="True" Margin="4,6" Click="Refresh"/>
   <TextBlock Text="Search by filename or folder. Select a thumbnail, then choose its layer. Double-click opens it as the base." Margin="4" TextWrapping="Wrap"/>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom">
   <TextBlock x:Name="Status" Margin="4" TextWrapping="Wrap"/>
   <WrapPanel HorizontalAlignment="Right"><Button x:Name="BaseButton" Content="Use as base texture" Click="UseBase" IsEnabled="False"/><Button x:Name="FlowButton" Content="Use as animated texture" Click="UseFlow" IsEnabled="False"/><Button Content="Cancel" IsCancel="True"/></WrapPanel>
  </StackPanel>
  <ListBox x:Name="Results" Background="#202838" Foreground="#E8EDF7" SelectionChanged="Selected" MouseDoubleClick="DoubleClick"
    ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
   <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="6"/></Style></ListBox.ItemContainerStyle>
   <ListBox.ItemTemplate><DataTemplate>
    <Grid Height="142" Loaded="RowLoaded" Unloaded="RowUnloaded">
     <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Background="#364052" BorderBrush="#52647F" BorderThickness="1" Width="138" Height="138">
      <Grid><TextBlock Text="Loading preview…" Foreground="#C0CCDF" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Image Source="{Binding Thumbnail}" Stretch="Uniform"/></Grid>
     </Border>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
      <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="{Binding RelativePath}" Foreground="#AFC0D8" TextWrapping="Wrap" Margin="0,6"/>
      <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="#AFC0D8"/>
     </StackPanel>
    </Grid>
   </DataTemplate></ListBox.ItemTemplate>
  </ListBox>
 </DockPanel>
</Window>
